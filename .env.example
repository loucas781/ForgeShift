# ─────────────────────────────────────────────────────────────────────────────
# ForgeShift — Environment Configuration
#
# HOW TO USE:
#   cp .env.example .env
#   Edit .env with your real values
#
# IMPORTANT:
#   .env is listed in .gitignore and must NEVER be committed to version control.
#   Only this file (.env.example) belongs in the repository.
#   It contains no real secrets — only safe placeholder values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ────────────────────────────────────────────────────────────

# Environment: development | staging | production
NODE_ENV=production

# Display name shown in the UI
APP_NAME=ForgeShift

# ── Server ─────────────────────────────────────────────────────────────────

PORT=3000
HOST=0.0.0.0

# ── Session ────────────────────────────────────────────────────────────────

# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Must be at least 64 characters. Change this — do not use the placeholder.
SESSION_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_STRING_AT_LEAST_64_CHARS

# Session lifetime in milliseconds (default: 7 days)
SESSION_MAX_AGE=604800000

# ── Database ───────────────────────────────────────────────────────────────

DB_PATH=./data/forgeshift.db
SESSION_DB_PATH=./data/sessions.db

# ── Rate limiting ──────────────────────────────────────────────────────────

# General API: 200 requests per 15 minutes
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# Auth endpoints (login/register): 20 attempts per 15 minutes
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# ── Admin seed account ─────────────────────────────────────────────────────
# Used only on first run (npm run seed). Change the password after first login.
# You can remove these lines from .env once the admin account has been created.

ADMIN_EMAIL=admin@forgeshift.app
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Administrator

# ── iCal ───────────────────────────────────────────────────────────────────

# Name that appears in calendar apps when subscribing to a feed
ICAL_CALENDAR_NAME=ForgeShift

# ── Proxy & cookies ────────────────────────────────────────────────────────

# Set to 1 if running behind nginx, Caddy, or Cloudflare
TRUST_PROXY=1

# Set to true when serving over HTTPS (required in production)
COOKIE_SECURE=true
COOKIE_SAME_SITE=strict
