# ForgeShift Environment Configuration
# Copy to .env.development / .env.staging / .env.production and fill in values.
# NEVER commit the filled-in file — only this example is committed.

# App
NODE_ENV=development
PORT=3000
APP_NAME=ForgeShift
APP_URL=http://your-server-ip:3000
APP_ENV=development

# Security — generate with: openssl rand -hex 48
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_48

# Password pepper — HMAC-SHA256'd into every password before bcrypt.
# A leaked database is useless without this value.
# Generate with: openssl rand -hex 32
# NEVER change after users are created — passwords will stop working.
# To rotate: set PASSWORD_PEPPER_OLD=<old>, PASSWORD_PEPPER=<new>
PASSWORD_PEPPER=CHANGE_ME_generate_with_openssl_rand_hex_32

# SQLite database path (defaults to ./data/forgeshift.db)
DATABASE_PATH=./data/forgeshift.db

# Cookies
COOKIE_SECURE=false
TRUST_PROXY=false
COOKIE_MAX_AGE_HOURS=72
