# ForgeShift Environment Configuration
# Copy to .env.development / .env.staging / .env.production and fill in values.
# NEVER commit the filled-in file — only this example is committed.

# App
NODE_ENV=development
PORT=3000
APP_NAME=ForgeShift
APP_URL=http://your-server-ip:3000
APP_ENV=development

# GitHub release checks for the in-app Updates page.
# GITHUB_REPO should be in owner/repo format.
# GITHUB_TOKEN is optional, but helps avoid GitHub API rate limits.
GITHUB_REPO=loucas781/ForgeShift
GITHUB_TOKEN=

# Security — generate with: openssl rand -hex 48
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_48

# Password pepper — HMAC-SHA256'd into every password before bcrypt.
# A leaked database is useless without this value.
# Generate with: openssl rand -hex 32
# NEVER change after users are created — passwords will stop working.
# To rotate: set PASSWORD_PEPPER_OLD=<old>, PASSWORD_PEPPER=<new>
PASSWORD_PEPPER=CHANGE_ME_generate_with_openssl_rand_hex_32

# SQLite database path (defaults to ./data/forgeshift.db)
DATABASE_PATH=./data/forgeshift.db

# Cookies
COOKIE_SECURE=false
TRUST_PROXY=false
COOKIE_MAX_AGE_HOURS=72

# ── Apple Push Notification Service (APNs) ──────────────────────────────────
# Optional — only required for iOS push notifications.
# 1. Sign in to developer.apple.com → Certificates, IDs & Profiles → Keys
# 2. Create a new key, enable "Apple Push Notifications service (APNs)"
# 3. Download the .p8 file and note the Key ID and your Team ID
#
# APNS_KEY_ID     10-character Key ID shown in the developer portal
# APNS_TEAM_ID    10-character Team ID (top-right of developer.apple.com)
# APNS_KEY_PATH   Path to the downloaded .p8 file
# APNS_BUNDLE_ID  iOS app bundle ID (must match the Xcode project)
# APNS_PRODUCTION Set to "true" for App Store / TestFlight builds; leave false for dev
APNS_KEY_ID=XXXXXXXXXX
APNS_TEAM_ID=XXXXXXXXXX
APNS_KEY_PATH=./config/AuthKey_XXXXXXXXXX.p8
APNS_BUNDLE_ID=com.forgeshift.app
APNS_PRODUCTION=false
