# ─────────────────────────────────────────────────────────────────────────────
# ForgeShift Systemd Service
# Alternative to PM2 – uses native systemd for process management
#
# Install:
#   sudo cp deploy/forgeshift.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable forgeshift
#   sudo systemctl start forgeshift
#
# Manage:
#   sudo systemctl status forgeshift
#   sudo systemctl restart forgeshift
#   sudo journalctl -u forgeshift -f
# ─────────────────────────────────────────────────────────────────────────────

[Unit]
Description=ForgeShift – Shift Rota Management
Documentation=https://github.com/your-org/forgeshift
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data

# ── Paths (adjust to your deployment location) ────────────────────────────
WorkingDirectory=/var/www/forgeshift
ExecStart=/usr/bin/node src/server.js

# ── Environment ───────────────────────────────────────────────────────────
# Load .env from the app directory
EnvironmentFile=/var/www/forgeshift/.env

# ── Process Management ────────────────────────────────────────────────────
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=forgeshift

# ── Security Hardening ────────────────────────────────────────────────────
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/forgeshift/data
PrivateTmp=true

[Install]
WantedBy=multi-user.target
